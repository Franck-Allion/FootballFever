{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FootballFever",
  "version": "0.1.0",
  "identifier": "com.fal.footballfever",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FootballFever",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Fal",
    "copyright": "Copyright (c) 2026 Fal",
    "shortDescription": "FootballFever",
    "longDescription": "FootballFever desktop build."
  }
}
